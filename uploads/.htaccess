# Yüklenen görseller: yalnızca resim dosyaları sunulur, betik çalıştırılmaz.
# Uploaded images: only image files are served, no scripts are executed.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|shtml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
